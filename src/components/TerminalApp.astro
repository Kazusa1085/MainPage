---
import { identity, interests, gear, quotes, site, profile, links as linksData, rss as rssConfig, projects as projectsConfig, theme } from '../data/config.js';
import { fetchArticles } from '../data/fetch-rss.js';
import { fetchRepos } from '../data/fetch-github.js';

const articles = rssConfig.enabled ? await fetchArticles(rssConfig.url, rssConfig.count) : [];
const repos = projectsConfig.enabled ? await fetchRepos(projectsConfig.githubUser, projectsConfig.count, projectsConfig.exclude) : [];
const defaultMode = theme.default === 'light' ? 'light' : 'dark';
const terminalData = JSON.stringify({ identity, interests, gear, quotes, articles, repos, linksData, site, profile, defaultMode }).replace(/</g, '\\u003c');
---

<script id="terminal-data" type="application/json" is:inline set:html={terminalData}></script>

<div class="terminal-backdrop">
  <div class="terminal-window">
    <div class="terminal-titlebar">
      <div class="traffic-lights" aria-hidden="true">
        <span class="close"></span>
        <span class="minimize"></span>
        <span class="maximize"></span>
      </div>
      <span class="terminal-title">kazusa@127.0.0.1</span>
    </div>

    <div class="terminal-body" id="terminal-body">
      <div class="terminal-output" id="terminal-output"></div>
      <form class="terminal-prompt-form" id="terminal-form">
        <label class="terminal-prompt-text" for="terminal-input">
          <span class="prompt-user">visitor@raana.icu</span><span class="prompt-path">:~$</span>
        </label>
        <input
          id="terminal-input"
          class="terminal-input"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="终端命令输入"
          placeholder="welcome"
        />
      </form>
    </div>
  </div>
</div>

<script>
  import { initTerminalApp } from '../scripts/terminal-app.js';
  const data = JSON.parse(document.getElementById('terminal-data').textContent);
  initTerminalApp(data);
</script>
